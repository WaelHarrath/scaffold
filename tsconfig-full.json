{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false
  },
  "include": [
    "src/**/*.ts",
    "benchmarks/phase6-runner.ts",
    "benchmarks/phase7-runner.ts",
    "benchmarks/phase8-parity-runner.ts",
    "benchmarks/phase8-audit.ts",
    "scripts/run-phase7.ts",
    "scripts/write-phase7-report.ts",
    "scripts/run-phase8.ts",
    "scripts/write-phase8-report.ts"
  ],
  "exclude": ["benchmarks/phase3-runner.ts", "benchmarks/phase4-runner.ts"]
}
