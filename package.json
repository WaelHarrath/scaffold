{
  "name": "scaffold",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "phase1": "tsc && node --experimental-specifier-resolution=node dist/scripts/run-phase1.js",
    "phase1:run": "npx tsx scripts/run-phase1.ts",
    "phase3": "npx tsx benchmarks/phase3-runner.ts",
    "phase3:run": "npx tsx benchmarks/phase3-runner.ts",
    "phase4": "npx tsx benchmarks/phase4-runner.ts",
    "phase4:run": "npx tsx benchmarks/phase4-runner.ts",
    "phase6": "npx tsx scripts/run-phase6.ts",
    "phase6:run": "npx tsx scripts/run-phase6.ts",
    "phase7": "npx tsx scripts/run-phase7.ts",
    "phase7:run": "npx tsx scripts/run-phase7.ts",
    "phase8": "npx tsx scripts/run-phase8.ts",
    "phase8:run": "npx tsx scripts/run-phase8.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.0"
  }
}
